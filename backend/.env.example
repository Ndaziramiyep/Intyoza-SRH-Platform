# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=
JWT_SECRET=replace-me-with-a-32-plus-char-random-string
JWT_EXPIRES_IN=7d

# AI provider: "intyoza" = the trained model in ai/intyoza_srh (run `python -m intyoza_srh`), "mock" = fixed replies
AI_PROVIDER=intyoza
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=15000
# The AI service key (same value as INTYOZA_API_KEY on the AI service). With it, the AI sees the conversation
# (follow-up questions, names, quiz). Without it, each message is answered on its own.
AI_SERVICE_KEY=

# Web app origin allowed to call the API from a browser (not needed with the Vite dev proxy)
CORS_ORIGIN=